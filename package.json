{
	"name": "enable-responsive-image",
	"version": "1.7.0",
	"description": "WordPress plugin that adds settings to the Image block to display different images depending on the width of the screen.",
	"author": "Aki Hamano",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"gutenberg",
		"block",
		"image",
		"responsive"
	],
	"homepage": "https://github.com/t-hamano/enable-responsive-image",
	"repository": "git+https://github.com/t-hamano/enable-responsive-image.git",
	"bugs": {
		"url": "https://github.com/t-hamano/enable-responsive-image/issues"
	},
	"engines": {
		"node": ">=24.22.1",
		"npm": ">=11.19.1"
	},
	"files": [
		"src",
		"build",
		"enable-responsive-image.php",
		"readme.txt"
	],
	"dependencies": {
		"@wordpress/ui": "0.25.0"
	},
	"devDependencies": {
		"@types/wordpress__block-editor": "15.0.8",
		"@wordpress/blob": "5.0.0",
		"@wordpress/block-editor": "19.0.0",
		"@wordpress/blocks": "17.0.0",
		"@wordpress/components": "43.0.0",
		"@wordpress/compose": "9.0.0",
		"@wordpress/core-data": "9.0.0",
		"@wordpress/data": "11.0.0",
		"@wordpress/e2e-test-utils-playwright": "3.1.0",
		"@wordpress/element": "10.0.0",
		"@wordpress/env": "^12.0.0",
		"@wordpress/hooks": "5.0.0",
		"@wordpress/i18n": "7.0.0",
		"@wordpress/icons": "19.0.0",
		"@wordpress/notices": "6.0.0",
		"@wordpress/primitives": "5.0.0",
		"@wordpress/scripts": "^37.0.0",
		"clsx": "2.1.1",
		"husky": "^9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "npm:wp-prettier@3.9.6",
		"typescript": "6.0.3"
	},
	"scripts": {
		"wp-env": "wp-env",
		"wp-env-test": "wp-env --config .wp-env.test.json",
		"start": "wp-scripts start",
		"build": "wp-scripts build",
		"plugin-zip": "npm run build && wp-scripts plugin-zip",
		"check-licenses": "wp-scripts check-licenses",
		"lint": "npm run lint:css && npm run lint:js && npm run lint:types && npm run lint:php && npm run lint:md-docs && npm run lint:pkg-json",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:types": "tsc",
		"lint:php": "vendor/bin/phpcs",
		"lint:md-docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"format": "wp-scripts format",
		"test:php": "wp-env --config .wp-env.test.json run cli --env-cwd=wp-content/plugins/enable-responsive-image vendor/bin/phpunit",
		"test:e2e": "wp-scripts test-playwright --wp-env-config=.wp-env.test.json",
		"test:e2e:debug": "wp-scripts test-playwright --wp-env-config=.wp-env.test.json --debug",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,json,ts,tsx,yml,yaml}": [
			"wp-scripts format"
		],
		"*.{js,ts,tsx}": [
			"wp-scripts lint-js"
		],
		"*.scss": [
			"wp-scripts lint-style"
		],
		"*.md": [
			"wp-scripts lint-md-docs"
		],
		"package.json": [
			"wp-scripts lint-pkg-json"
		]
	}
}
