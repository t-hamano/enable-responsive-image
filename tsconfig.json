{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": [ "dom", "esnext" ],
		"jsx": "preserve",
		"allowJs": true,
		"checkJs": false,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"verbatimModuleSyntax": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": [ "src/**/*", "src/**/*.json", "test/**/*" ],
	"exclude": [ "**/build/**" ]
}
